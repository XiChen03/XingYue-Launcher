<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:XingYue" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageOtherTest"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,25,25,10" Grid.IsSharedSizeScope="True">

            <local:MyCard Title="百宝箱" Margin="0,0,0,15">
                <Grid Margin="25,40,23,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <local:MyButton x:Name="BtnJrrp" Grid.Column="0" Height="35" Text="今日人品"
                                    ToolTip="算一算你今天的人品值。&#xA;每天只会算一次，换电脑结果也会变哦。" />
                    <local:MyButton x:Name="BtnMemory" Grid.Column="2" Height="35" Text="内存优化"
                                    ToolTip="将物理内存占用降低约 1/3，不仅限于 MC！&#xA;如果使用机械硬盘，这可能会导致一小段时间的严重卡顿。&#xA;使用 --memory 参数启动 XingYue Launcher 可以静默执行内存优化。" />
                    <local:MyButton x:Name="BtnClear" Grid.Column="4" Height="35" Text="清理游戏垃圾"
                                    ToolTip="清理 XingYue Launcher 的缓存与 MC 的日志、崩溃报告等垃圾文件。&#xA;清理完成后需要重启 XingYue Launcher。" />
                    <local:MyButton x:Name="BtnClick" Grid.Column="6" Height="35" Text="千万别点" ColorType="Red" />
                </Grid>
            </local:MyCard>

            <local:MyCard x:Name="CardCave" Title="回声洞" Margin="0,0,0,15">
                <Grid Margin="25,40,23,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="LabCave" TextWrapping="Wrap" TextTrimming="None" FontSize="13.5" Margin="0,0,12,4"
                                   Text="反复点击这里可以查看各位沙雕网友乱七八糟的留言！" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6" Text="点击这张卡片可以换一条留言。" />
                    </StackPanel>
                </Grid>
            </local:MyCard>

            <local:MyCard Title="下载自定义文件" Margin="0,0,0,15">
                <StackPanel Margin="25,40,23,20">
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="使用 XingYue Launcher 的高速多线程下载引擎下载任意文件。请注意，部分网站（例如百度网盘）可能会报错 (403) 已禁止，无法正常下载。" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="DownloadLabel" />
                            <ColumnDefinition Width="25" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="下载地址" />
                        <local:MyTextBox x:Name="TextDownloadUrl" Grid.Row="0" Grid.Column="2" Height="28"
                                         HintText="例如 https://example.com/file.zip">
                            <local:MyTextBox.ValidateRules>
                                <local:ValidateExcept>
                                    <local:ValidateExcept.Excepts>
                                        <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">ftp://</System:String>
                                    </local:ValidateExcept.Excepts>
                                </local:ValidateExcept>
                                <local:ValidateHttp />
                            </local:MyTextBox.ValidateRules>
                        </local:MyTextBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="保存到" />
                        <local:MyTextBox x:Name="TextDownloadFolder" Grid.Row="2" Grid.Column="2" Height="28"
                                         HintText="保存文件的文件夹">
                            <local:MyTextBox.ValidateRules>
                                <local:ValidateFolderPath />
                            </local:MyTextBox.ValidateRules>
                        </local:MyTextBox>
                        <local:MyButton x:Name="BtnDownloadSelect" Grid.Row="2" Grid.Column="4" Text="选择"
                                        Height="28" Padding="14,0,14,0" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="文件名" />
                        <local:MyTextBox x:Name="TextDownloadName" Grid.Row="4" Grid.Column="2" Height="28"
                                         HintText="保存的文件名，填写网址后会自动生成">
                            <local:MyTextBox.ValidateRules>
                                <local:ValidateFileName UseMinecraftCharCheck="True" RequireParentFolderExists="False" />
                            </local:MyTextBox.ValidateRules>
                        </local:MyTextBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnDownloadStart" Text="开始下载" Height="30" Padding="20,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnDownloadOpen" Text="打开文件夹" Height="30" Padding="14,0,14,0" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
