<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:XingYue" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageOtherServer"
    d:DesignWidth="800" d:DesignHeight="600">
    <local:MyScrollViewer x:Name="PanRoot" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="25,25,25,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition x:Name="ColSideGap" Width="15" />
                <ColumnDefinition x:Name="ColSide" Width="285" />
            </Grid.ColumnDefinitions>

            <local:MyCard x:Name="CardMain" Grid.Column="0" Title="服务器控制台">
                <Grid Margin="25,40,25,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶部功能页签 -->
                    <UniformGrid x:Name="PanTabs" Grid.Row="0" Columns="3" HorizontalAlignment="Stretch" Margin="0,0,0,14" />

                    <Grid x:Name="PanTabHost" Grid.Row="1">
                        <!-- 控制台 -->
                        <Grid x:Name="PanTabConsole">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="{StaticResource ColorBrushGray5}" BorderThickness="1"
                                    CornerRadius="4" Padding="8" Height="330">
                                <local:MyScrollViewer x:Name="PanLogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <TextBox x:Name="TextLog" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                                </local:MyScrollViewer>
                            </Border>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextCommand" Grid.Column="0" MaxHeight="28" HintText="向服务器发送指令，例如 say hello"
                                                 KeyDown="TextCommand_KeyDown" />
                                <local:MyButton x:Name="BtnSend" Grid.Column="1" Text="发送" Margin="10,0,0,0" MinWidth="80" Padding="14,6" Click="BtnSend_Click" />
                            </Grid>
                        </Grid>

                        <!-- 实例设置 -->
                        <StackPanel x:Name="PanTabSettings" Visibility="Collapsed">
                            <StackPanel x:Name="PanSettingsHost" />
                            <WrapPanel Margin="0,14,0,0">
                                <local:MyButton x:Name="BtnSettingsSave" Text="保存设置" Padding="14,6" Click="BtnSettingsSave_Click" />
                                <local:MyButton x:Name="BtnSettingsReset" Text="重置更改" Padding="14,6" Margin="8,0,0,0" Click="BtnSettingsReset_Click" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- 服务器属性 -->
                        <StackPanel x:Name="PanTabProperties" Visibility="Collapsed">
                            <StackPanel x:Name="PanPropertiesHost" />
                            <WrapPanel Margin="0,14,0,0">
                                <local:MyButton x:Name="BtnPropertiesSave" Text="保存属性" Padding="14,6" Click="BtnPropertiesSave_Click" />
                                <local:MyButton x:Name="BtnPropertiesRaw" Text="编辑原始文件" Padding="14,6" Margin="8,0,0,0" Click="BtnPropertiesRaw_Click" />
                            </WrapPanel>
                        </StackPanel>

                        <!-- 备份管理 -->
                        <StackPanel x:Name="PanTabBackup" Visibility="Collapsed">
                            <WrapPanel Margin="0,0,0,12">
                                <local:MyButton x:Name="BtnBackupCreate" Text="创建备份" Padding="14,6" Click="BtnBackupCreate_Click" />
                                <local:MyButton x:Name="BtnBackupRefresh" Text="刷新列表" Padding="14,6" Margin="8,0,0,0" Click="BtnBackupRefresh_Click" />
                                <local:MyButton x:Name="BtnBackupFolder" Text="打开备份目录" Padding="14,6" Margin="8,0,0,0" Click="BtnBackupFolder_Click" />
                            </WrapPanel>
                            <StackPanel x:Name="PanBackups" />
                        </StackPanel>

                        <!-- 插件 / 模组 -->
                        <Grid x:Name="PanTabPlugins" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <!--左列：在线下载-->
                            <local:MyScrollViewer x:Name="PanModScrollLeft" Grid.Column="0" MaxHeight="330" Margin="0,0,6,0"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock x:Name="LabModDownloadTitle" Text="在线下载模组（来源：CurseForge / Modrinth）"
                                               FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource ColorBrush2}" />
                                    <!--搜索行：搜索框吃掉剩余宽度，与下面两个下拉框整体左右对齐-->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:MyTextBox x:Name="TextModQuery" MaxHeight="28" HintText="搜索名称" />
                                        <local:MyButton x:Name="BtnModSearch" Grid.Column="1" Text="搜索" MinWidth="72"
                                                        Padding="14,6" Margin="8,0,0,0" Click="BtnModSearch_Click" />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <local:MyComboBox x:Name="ComboModVersion" IsEditable="True" HintText="游戏版本" />
                                        <local:MyComboBox x:Name="ComboModLoader" Grid.Column="2" />
                                    </Grid>
                                    <StackPanel x:Name="PanModResults" Margin="0,0,0,6" />
                                </StackPanel>
                            </local:MyScrollViewer>

                            <!--右列：已安装-->
                            <local:MyScrollViewer x:Name="PanModScrollRight" Grid.Column="2" MaxHeight="330"
                                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="已安装" FontSize="12" Margin="0,0,0,6" Foreground="{StaticResource ColorBrushGray3}" />
                                    <WrapPanel Margin="0,0,0,12">
                                        <local:MyButton x:Name="BtnPluginKind" Text="插件" Padding="14,6" Click="BtnPluginKind_Click" />
                                        <local:MyButton x:Name="BtnPluginImport" Text="导入 jar" Padding="14,6" Margin="8,0,0,0" Click="BtnPluginImport_Click" />
                                        <local:MyButton x:Name="BtnPluginFolder" Text="打开目录" Padding="14,6" Margin="8,0,0,0" Click="BtnPluginFolder_Click" />
                                        <local:MyButton x:Name="BtnPluginRefresh" Text="刷新" Padding="14,6" Margin="8,0,0,0" Click="BtnPluginRefresh_Click" />
                                    </WrapPanel>
                                    <StackPanel x:Name="PanPlugins" />
                                </StackPanel>
                            </local:MyScrollViewer>
                        </Grid>

                        <!-- 文件管理 -->
                        <StackPanel x:Name="PanTabFiles" Visibility="Collapsed">
                            <WrapPanel Margin="0,0,0,12">
                                <local:MyTextButton x:Name="BtnFileUp" Text="← 上一级" Margin="0,0,14,0" Click="BtnFileUp_Click" />
                                <TextBlock x:Name="LabFilePath" Text="/" VerticalAlignment="Center" FontSize="12.5"
                                           Foreground="{StaticResource ColorBrushGray3}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,12">
                                <local:MyButton x:Name="BtnFileRefresh" Text="刷新" Padding="14,6" Click="BtnFileRefresh_Click" />
                                <local:MyButton x:Name="BtnFileMkdir" Text="新建文件夹" Padding="14,6" Margin="8,0,0,0" Click="BtnFileMkdir_Click" />
                                <local:MyButton x:Name="BtnFileOpenDir" Text="打开目录" Padding="14,6" Margin="8,0,0,0" Click="BtnFileOpenDir_Click" />
                            </WrapPanel>
                            <StackPanel x:Name="PanFiles" />
                        </StackPanel>

                        <!-- 玩家管理 -->
                        <StackPanel x:Name="PanTabPlayers" Visibility="Collapsed">
                            <WrapPanel Margin="0,0,0,12">
                                <local:MyButton x:Name="BtnPlayersRefresh" Text="刷新名单" Padding="14,6" Click="BtnPlayersRefresh_Click" />
                                <local:MyButton x:Name="BtnWhitelistOn" Text="开启白名单" Padding="14,6" Margin="8,0,0,0" Click="BtnWhitelistOn_Click" />
                                <local:MyButton x:Name="BtnWhitelistOff" Text="关闭白名单" Padding="14,6" Margin="8,0,0,0" Click="BtnWhitelistOff_Click" />
                            </WrapPanel>
                            <StackPanel x:Name="PanPlayerLists" />
                        </StackPanel>

                        <!-- 定时任务 -->
                        <StackPanel x:Name="PanTabTasks" Visibility="Collapsed">
                            <TextBlock Text="执行时间（24 小时制）" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource ColorBrushGray3}" />
                            <WrapPanel Margin="0,0,0,10">
                                <local:MyTextBox x:Name="TextTaskTime" MaxHeight="28" Width="90" HintText="04:00" />
                                <local:MyComboBox x:Name="ComboTaskAction" Width="170" Margin="8,0,0,0">
                                    <local:MyComboBoxItem Content="创建备份" Tag="backup" IsSelected="True" />
                                    <local:MyComboBoxItem Content="重启服务器" Tag="restart" />
                                    <local:MyComboBoxItem Content="停止服务器" Tag="stop" />
                                    <local:MyComboBoxItem Content="启动服务器" Tag="start" />
                                    <local:MyComboBoxItem Content="发送指令" Tag="command" />
                                </local:MyComboBox>
                            </WrapPanel>
                            <TextBlock Text="动作参数（选「发送指令」时填写，其它动作可留空）" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource ColorBrushGray3}" />
                            <local:MyTextBox x:Name="TextTaskCommand" MaxHeight="28" Margin="0,0,0,10" HintText="say 晚安" />
                            <local:MyButton x:Name="BtnTaskAdd" Text="添加任务" Padding="16,7" HorizontalAlignment="Left" Click="BtnTaskAdd_Click" />
                            <StackPanel x:Name="PanTasks" Margin="0,14,0,0" />
                        </StackPanel>

                        <!-- 下载核心 -->
                        <StackPanel x:Name="PanTabDownload" Visibility="Collapsed">
                            <TextBlock Text="来源" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource ColorBrushGray3}" />
                            <WrapPanel Margin="0,0,0,10">
                                <local:MyComboBox x:Name="ComboCoreSource" Width="150" SelectionChanged="ComboCoreSource_SelectionChanged" />
                            </WrapPanel>
                            <TextBlock Text="游戏版本" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource ColorBrushGray3}" />
                            <WrapPanel Margin="0,0,0,10">
                                <local:MyComboBox x:Name="ComboCoreGameVersion" Width="150" SelectionChanged="ComboCoreGameVersion_SelectionChanged" />
                            </WrapPanel>
                            <TextBlock x:Name="LabCoreLoaderTitle" Text="加载器版本" FontSize="12" Margin="0,0,0,4" Foreground="{StaticResource ColorBrushGray3}" />
                            <WrapPanel Margin="0,0,0,12">
                                <local:MyComboBox x:Name="ComboCoreLoaderVersion" Width="150" SelectionChanged="ComboCoreLoaderVersion_SelectionChanged" />
                                <local:MyButton x:Name="BtnCoreDownload" Text="下载到实例" Padding="12,6" Margin="8,0,0,0" Click="BtnCoreDownload_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="LabCoreStatus" Text="先选来源和游戏版本，再选加载器版本，最后点「下载到实例」。文件会存到服务端目录，并自动设为启动核心。"
                                       FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray3}" />
                            <TextBlock Text="Forge / NeoForge 会额外运行官方安装器（已自动带上国内镜像），需要几分钟，完成后会自动填好启动参数文件。"
                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray4}" />
                            <TextBlock Text="提示：1.20.5 及以上的服务端需要 Java 21，可以在「实例设置」里手动指定 Java。"
                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource ColorBrushGray4}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </local:MyCard>

            <StackPanel x:Name="PanSide" Grid.Column="2">
                <local:MyCard Title="实例状态" Margin="0,0,0,12">
                    <StackPanel Margin="25,40,25,20">
                        <WrapPanel Margin="0,0,0,12">
                            <TextBlock x:Name="LabStatusIcon" Text="●" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource ColorBrushGray4}" />
                            <TextBlock x:Name="LabStatus" Text="已停止" FontSize="15" VerticalAlignment="Center" />
                        </WrapPanel>
                        <local:MyButton x:Name="BtnStart" Text="启动服务器" Padding="14,6" Click="BtnStart_Click" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnStop" Grid.Column="0" Text="停止" ColorType="Red" Padding="14,6" Click="BtnStop_Click" />
                            <local:MyButton x:Name="BtnRestart" Grid.Column="2" Text="重启" Padding="14,6" Click="BtnRestart_Click" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnOpenFolder" Grid.Column="0" Text="浏览文件夹" Padding="14,6" Click="BtnOpenFolder_Click" />
                            <local:MyButton x:Name="BtnChooseDir" Grid.Column="2" Text="选择服务端" Padding="14,6" Click="BtnChooseDir_Click" />
                        </Grid>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Title="实例概览" Margin="0,0,0,12">
                    <StackPanel x:Name="PanOverview" Margin="25,40,25,20" />
                </local:MyCard>

                <local:MyCard Title="在线玩家" Margin="0,0,0,12">
                    <StackPanel x:Name="PanPlayers" Margin="25,40,25,20" />
                </local:MyCard>
            </StackPanel>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>
