<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:XingYue" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupLink"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard x:Name="CardArgument" Margin="0,15" Title="EasyTier 连接选项">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="模式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="0" x:Name="ComboLatencyMode" Grid.ColumnSpan="2" local:SettingService.Key="LinkLatencyMode" Grid.Column="1">
                            <local:MyComboBoxItem Content="优先直连" IsSelected="True" ToolTip="尽量不进行中转，而是 P2P 直连。" />
                            <local:MyComboBoxItem Content="优先低延迟" ToolTip="如果使用中转节点能降低延迟，就不进行直连。&#xa;不过，这会增加社区节点的负载……" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="自定义节点" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextCustomPeer" local:SettingService.Key="LinkCustomPeer" Grid.Column="1" MaxHeight="28" 
                            ToolTip="覆盖 XingYue Launcher 所选择的节点，仅连接此处填写的节点。&#xa;如果你自己搭建了 EasyTier 节点，你可以用这个设置让 XingYue Launcher 连接它。&#xa;&#xa;使用逗号分隔多个节点，例如：&#xa;tcp://public.easytier.cn:11010,tcp://public2.easytier.cn:54321&#xa;&#xa;房主和加入者必须连接到至少一个相同节点，才能互相连上。" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Left">
                        <local:MyButton x:Name="BtnCheckPeer" MinWidth="140" Padding="13,5" Margin="0,0,20,0" HorizontalAlignment="Left"
                            Text="测试自定义节点连接状态"
                            ToolTip="测试上方「自定义节点」里填写的节点能否连通。&#xa;只会做一次 TCP 连接测试，不会加入联机房间。" />
                        <local:MyButton x:Name="BtnAddSelfPeer" MinWidth="120" Padding="13,5" HorizontalAlignment="Left"
                            Text="自用服务器节点"
                            ToolTip="把 tcp://xywm.dpdns.org:11010 添加到上方的「自定义节点」中。&#xa;如果已经有这个节点，则不会重复添加。" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardSakura" Margin="0,0,0,15" Title="樱花映射 (SakuraFrp)">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="访问密钥" Margin="0,0,25,0" />
                        <local:MyTextBox Grid.Row="0" x:Name="TextSakuraToken" Grid.Column="1" MaxHeight="28"
                            ToolTip="在管理面板 https://www.natfrp.com/user/ 点击「查看访问密钥」获取。&#xa;访问密钥是专门给客户端登录用的密码，和你网页账号的登录密码不是一回事。" />
                    </Grid>
                    <TextBlock x:Name="LabSakuraLogin" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12.5"
                               Text="尚未登录樱花映射。" Foreground="{StaticResource ColorBrushGray3}" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Left">
                        <local:MyButton x:Name="BtnSakuraLogin" MinWidth="110" Padding="13,5" Margin="0,0,15,0" Text="登录" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnSakuraLogout" MinWidth="110" Padding="13,5" Margin="0,0,15,0" Text="退出登录" />
                        <local:MyButton x:Name="BtnSakuraOpenPanel" MinWidth="130" Padding="13,5" Text="打开樱花映射官网" />
                    </StackPanel>
                    <TextBlock Margin="0,14,0,0" FontSize="12.5" LineHeight="18" Foreground="{StaticResource ColorBrushGray3}" TextWrapping="Wrap"
                               Text="登录后即可在 联机 → 樱花映射 中创建隧道，把联机端口映射到公网。&#xa;注意：创建隧道会消耗你樱花映射账号的隧道数量与流量额度。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
