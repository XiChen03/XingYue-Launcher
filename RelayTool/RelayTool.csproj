<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>XingYue联机中转节点</AssemblyName>
    <RootNamespace>XingYueRelay</RootNamespace>
    <ApplicationIcon>..\XingYue\Images\icon.ico</ApplicationIcon>
    <AssemblyTitle>XingYue联机中转节点</AssemblyTitle>
    <Product>XingYue联机中转节点</Product>
    <Company>XingYue</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>disable</Nullable>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\XingYue\Resources\EasyTier-core-x86_64.zip" LogicalName="EasyTierCore.zip" />
  </ItemGroup>

  <!-- 构建后把中转节点复制到启动器输出目录，方便一起发布 -->
  <Target Name="CopyToLauncherBin" AfterTargets="Build" Condition="Exists('..\XingYue\bin')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="..\XingYue\bin" SkipUnchangedFiles="true" />
  </Target>

</Project>
